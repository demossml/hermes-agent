{
  "name": "hermes-agent",
  "displayName": "Hermes Agent — Local AI Copilot",
  "description": "Copilot-like AI coding assistant powered by your local Hermes LLM. Inline completions, chat, context-aware suggestions — all fully local via OpenAI-compatible API.",
  "version": "2.0.0",
  "publisher": "hermes-agent",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/demossml/hermes-agent"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai", "agent", "hermes", "copilot", "local", "llm", "coding",
    "inline", "completion", "chat", "openai", "api"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes-sidebar",
          "title": "Hermes Agent",
          "icon": "resources/hermes-icon.svg"
        }
      ]
    },
    "views": {
      "hermes-sidebar": [
        {
          "id": "hermes.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "hermes-agent.hermes",
        "fullName": "Hermes Agent",
        "description": "Your local AI coding assistant — explain, refactor, test, and more",
        "isSticky": true,
        "commands": [
          { "name": "explain", "description": "Explain what the selected code does" },
          { "name": "fix", "description": "Find and fix bugs in the selected code" },
          { "name": "tests", "description": "Generate unit tests for the selected code" },
          { "name": "refactor", "description": "Refactor for readability and maintainability" },
          { "name": "docs", "description": "Add docstrings and comments" },
          { "name": "optimize", "description": "Optimize for performance" }
        ]
      }
    ],
    "commands": [
      { "command": "hermes.explainCode", "title": "Hermes: Explain This Code" },
      { "command": "hermes.refactorCode", "title": "Hermes: Refactor This Code" },
      { "command": "hermes.generateTests", "title": "Hermes: Generate Tests" },
      { "command": "hermes.generateDocs", "title": "Hermes: Generate Docstrings" },
      { "command": "hermes.findBugs", "title": "Hermes: Find Bugs" },
      { "command": "hermes.optimizeCode", "title": "Hermes: Optimize Performance" },
      { "command": "hermes.toggleInline", "title": "Hermes: Toggle Inline Completions" },
      { "command": "hermes.nextSuggestion", "title": "Hermes: Show Next Inline Suggestion" },
      { "command": "hermes.checkConnection", "title": "Hermes: Check Connection" },
      { "command": "hermes.openSettings", "title": "Hermes: Open Settings" },
      { "command": "hermes.quickSetup", "title": "Hermes: Quick Setup" },
      { "command": "hermes.openChat", "title": "Hermes: Open Chat", "icon": "$(comment-discussion)" }
    ],
    "menus": {
      "editor/context": [
        { "command": "hermes.explainCode", "group": "hermes@1", "when": "editorHasSelection" },
        { "command": "hermes.refactorCode", "group": "hermes@2", "when": "editorHasSelection" },
        { "command": "hermes.generateTests", "group": "hermes@3" },
        { "command": "hermes.findBugs", "group": "hermes@4" },
        { "command": "hermes.generateDocs", "group": "hermes@5" },
        { "command": "hermes.optimizeCode", "group": "hermes@6" }
      ],
      "view/title": [
        { "command": "hermes.openChat", "when": "view == hermes.chatView", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "hermes.nextSuggestion", "key": "ctrl+]", "when": "editorTextFocus && inlineSuggestionVisible" },
      { "command": "editor.action.inlineSuggest.trigger", "key": "alt+\\", "when": "editorTextFocus && !inlineSuggestionVisible" }
    ],
    "configuration": {
      "title": "Hermes Agent",
      "properties": {
        "hermes.endpoint": {
          "type": "string",
          "default": "http://localhost:8642",
          "description": "OpenAI-compatible API endpoint (default: http://localhost:8642)"
        },
        "hermes.model": {
          "type": "string",
          "default": "",
          "description": "Model name (empty = auto-detect from /v1/models)"
        },
        "hermes.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key if your server requires authentication"
        },
        "hermes.inlineEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ghost-text inline completions (Tab to accept)"
        },
        "hermes.inlineDebounceMs": {
          "type": "integer",
          "default": 150,
          "minimum": 50,
          "maximum": 1000,
          "description": "Debounce delay (ms) before inline completion after typing stops"
        },
        "hermes.inlineMaxTokens": {
          "type": "integer",
          "default": 256,
          "minimum": 16,
          "maximum": 1024,
          "description": "Maximum tokens for inline completions"
        },
        "hermes.inlineTemperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for inline completions (lower = more predictable)"
        },
        "hermes.contextMode": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "openTabs", "workspace", "minimal"],
          "description": "Context gathering: auto, openTabs, workspace, minimal"
        },
        "hermes.maxContextFiles": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum additional files to include in context"
        },
        "hermes.contextLinesAroundCursor": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "maximum": 500,
          "description": "Lines of context around cursor for inline completions"
        },
        "hermes.chatMaxTokens": {
          "type": "integer",
          "default": 4096,
          "description": "Maximum tokens for chat responses"
        },
        "hermes.chatTemperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for chat responses (higher = more creative)"
        },
        "hermes.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show connection status in the status bar"
        },
        "hermes.statusBarLatency": {
          "type": "boolean",
          "default": true,
          "description": "Show latency in the status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
