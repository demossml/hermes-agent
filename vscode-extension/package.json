{
  "name": "hermes-agent",
  "displayName": "Hermes Agent",
  "description": "AI agent for coding, testing, and project management \u2014 Copilot-style inline edits, sidebar chat, tester integration",
  "version": "1.1.0",
  "publisher": "hermes-agent",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/demossml/hermes-agent"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "hermes",
    "coding",
    "testing",
    "chat",
    "multi-agent",
    "copilot",
    "inline",
    "completion"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes-sidebar",
          "title": "Hermes Agent",
          "icon": "resources/hermes-icon.svg"
        }
      ]
    },
    "views": {
      "hermes-sidebar": [
        {
          "id": "hermes.chatView",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "hermes.insightsView",
          "name": "Insights",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "hermes.openChat",
        "title": "Hermes: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hermes.switchProject",
        "title": "Hermes: Switch Project"
      },
      {
        "command": "hermes.showInsights",
        "title": "Hermes: Show Insights"
      },
      {
        "command": "hermes.runFullTest",
        "title": "Hermes: Run Full Test"
      },
      {
        "command": "hermes.openDashboard",
        "title": "Hermes: Open Dashboard"
      },
      {
        "command": "hermes.guardStatus",
        "title": "Hermes: Guard Status"
      },
      {
        "command": "hermes.askAboutCode",
        "title": "Hermes: Ask About Selected Code"
      },
      {
        "command": "hermes.improveCode",
        "title": "Hermes: Improve This Code"
      },
      {
        "command": "hermes.generateTests",
        "title": "Hermes: Generate Tests"
      },
      {
        "command": "hermes.analyzeWithBrowser",
        "title": "Hermes: Analyze with Browser Tool"
      },
      {
        "command": "hermes.runTesterOnFile",
        "title": "Hermes: Run Tester on This File"
      },
      {
        "command": "hermes.showStatus",
        "title": "Hermes: Show Status"
      },
      {
        "command": "hermes.currentProject",
        "title": "Hermes: Show Current Project"
      },
      {
        "command": "hermes.inlineImprove",
        "title": "Hermes: Inline Improve",
        "icon": "$(sparkle)"
      },
      {
        "command": "hermes.inlineFix",
        "title": "Hermes: Inline Fix",
        "icon": "$(debug)"
      },
      {
        "command": "hermes.inlineAddTests",
        "title": "Hermes: Inline Add Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "hermes.inlineAddComments",
        "title": "Hermes: Inline Add Comments",
        "icon": "$(book)"
      },
      {
        "command": "hermes.inlineMakeFaster",
        "title": "Hermes: Inline Make Faster",
        "icon": "$(zap)"
      },
      {
        "command": "hermes.syncStart",
        "title": "Hermes: Start Live Sync",
        "icon": ""
      },
      {
        "command": "hermes.syncStop",
        "title": "Hermes: Stop Live Sync",
        "icon": ""
      },
      {
        "command": "hermes.syncStatus",
        "title": "Hermes: Sync Status"
      },
      {
        "command": "hermes.openSettings",
        "title": "Hermes: Open Settings"
      },
      {
        "command": "hermes.quickSetup",
        "title": "Hermes: Quick Setup"
      },
      {
        "command": "hermes.testConnection",
        "title": "Hermes: Test Connection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hermes.inlineImprove",
          "group": "hermes@1",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.inlineFix",
          "group": "hermes@2",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.inlineAddTests",
          "group": "hermes@3",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.inlineAddComments",
          "group": "hermes@4",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.inlineMakeFaster",
          "group": "hermes@5",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.askAboutCode",
          "group": "hermes@6",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.runTesterOnFile",
          "group": "hermes@7",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == javascript"
        }
      ],
      "view/title": [
        {
          "command": "hermes.switchProject",
          "when": "view == hermes.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Hermes Agent",
      "properties": {
        "hermes.cliPath": {
          "type": "string",
          "default": "hermes",
          "description": "Path to the Hermes CLI"
        },
        "hermes.autoDetectProject": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect project from workspace"
        },
        "hermes.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show project in status bar"
        },
        "hermes.inlineEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Copilot-style inline edits"
        },
        "hermes.inlineTriggerDelay": {
          "type": "integer",
          "default": 300,
          "description": "Delay (ms) before triggering inline completion"
        },
        "hermes.chatModel": {
          "type": "string",
          "default": "",
          "description": "Override model for chat"
        },
        "hermes.maxContextFiles": {
          "type": "integer",
          "default": 5,
          "description": "Max files in context"
        },
        "hermes.server.tailscale": {
          "type": "boolean",
          "default": false,
          "description": "Connect to Hermes via Tailscale network (uses 100.x.x.x IP)"
        },
        "hermes.server.host": {
          "type": "string",
          "default": "",
          "description": "Hermes server host (auto-detected from Tailscale if tailscale=true)"
        },
        "hermes.server.port": {
          "type": "integer",
          "default": 8790,
          "description": "Hermes server port (default: 8790)"
        },
        "hermes.server.token": {
          "type": "string",
          "default": "",
          "description": "Auth token for Hermes server (optional)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "webpack --mode production --config webpack.ext.config.js",
    "build:webview": "cd webview && npm run build",
    "watch": "webpack --mode development --watch",
    "dev:webview": "cd webview && npm run dev",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "css-loader": "^6.8.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "marked": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}